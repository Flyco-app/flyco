{
  "name": "flyco",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --fail-on error",
    "db:test": "supabase test db --local",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "secrets:check": "node scripts/check-secrets.mjs",
    "db:design:check": "node scripts/check-schema.mjs",
    "db:start:database": "supabase db start",
    "db:start:auth": "supabase start --exclude realtime,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:auth:check": "node scripts/check-local-auth.mjs",
    "test:e2e:auth:local": "node scripts/run-local-auth-e2e.mjs",
    "db:profile:check": "node scripts/check-profile-api.mjs",
    "db:trips:check": "node scripts/check-trips-api.mjs",
    "db:delivery-requests:check": "node scripts/check-delivery-requests-api.mjs",
    "db:matching:check": "node scripts/check-matching-api.mjs",
    "db:bookings:check": "node scripts/check-bookings-api.mjs",
    "db:moderation:check": "node scripts/check-moderation-api.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "10.75.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "clsx": "2.1.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "server-only": "0.0.1",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.7",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "type": "module"
}
